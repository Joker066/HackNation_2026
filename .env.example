# Copy to .env and fill in. Never commit .env.

# LLM: "anthropic" (Claude) or "fake" (offline: always abstains, for development)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_PRICE_INPUT_PER_MTOK=0.10
LLM_PRICE_OUTPUT_PER_MTOK=0.50
LLM_EFFORT=low

# Admin endpoints (/api/logs, /api/metrics): send this value in the X-Admin-Token header.
# Leave empty to keep them disabled; if you set it, use a long random value, e.g.: openssl rand -hex 24
ADMIN_TOKEN=

# Where result links point (the web UI) and where the Discord bot finds the API
PUBLIC_BASE_URL=http://localhost:8000
API_BASE_URL=http://localhost:8000

# Discord bot token (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_INVITE_URL=

# Privacy: audit-log entries older than this are deleted on startup
RETENTION_DAYS=30


# Live sources (optional; each one adds evidence when its key is set)
GOOGLE_FACTCHECK_API_KEY=
EUVSDISINFO_API_KEY=
